# URL pública do SaaS (sem barra final)
APP_URL=https://sunny-friend-factory.lovable.app

# Mesmo valor do secret CRON_SECRET configurado no backend do SaaS.
# Usado pelo watcher para autenticar em /api/public/hooks/tunnel-url.
CRON_SECRET=

# API Key global da Evolution (mesmo valor do secret EVOLUTION_API_KEY no SaaS)
EVOLUTION_API_KEY=

# Banco local da Evolution (não é o banco do SaaS)
POSTGRES_USER=evolution
POSTGRES_PASSWORD=
